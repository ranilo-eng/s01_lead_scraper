      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst leads = rows.map(r => ({\n  prospect_name: `${r.json[\"First Name\"]} ${r.json[\"Last Name\"]}`.trim(),\n  company_name: r.json[\"Company Name\"] || r.json[\"Company Name for Emails\"] || null,\n  title: r.json[\"Title\"] || null,\n  email: r.json[\"Email\"] || null,\n  linkedin_url: r.json[\"Person Linkedin Url\"] || null,\n  company_size: r.json[\"# Employees\"] || null,\n  industry: r.json[\"Industry\"] || null,\n  country: r.json[\"Country\"] || null\n}));\n\nreturn [\n  {\n    json: {\n      status: \"SUCCESS\",\n      lead_data_array: leads,\n      meta: {\n        source: \"apollo_csv\",\n        total_records: leads.length\n      }\n    }\n  }\n];\n"
      },
