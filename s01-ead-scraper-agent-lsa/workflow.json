        "jsCode": "const body = $input.first().json.body;\n\nif (!body) {\n  return [{ json: { isValid: false, error: \"Missing request body\" } }];\n}\n\nconst { client_id, target_count, search_criteria } = body;\n\nif (!client_id) {\n  return [{ json: { isValid: false, error: \"client_id is required\" } }];\n}\n\nif (!target_count || typeof target_count !== \"number\") {\n  return [{ json: { isValid: false, error: \"target_count must be a number\" } }];\n}\n\nif (!search_criteria) {\n  return [{ json: { isValid: false, error: \"search_criteria is required\" } }];\n}\n\nreturn [\n  {\n    json: {\n      isValid: true,\n      client_id,\n      target_count,\n      search_criteria\n    }\n  }\n];\n"
      },
